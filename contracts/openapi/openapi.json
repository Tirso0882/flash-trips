            "title": "Stays",
            "type": "array"
          }
        },
        "required": [
          "stays"
        ],
        "title": "TripStructureResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "description": "Bearer access token",
        "scheme": "bearer",
        "type": "http"
      }
    }
