{
  "components": {
    "schemas": {
      "CreateTripRequest": {
        "properties": {
          "structure": {
            "$ref": "#/components/schemas/TripStructureInput"
          }
        },
        "required": [
          "structure"
        ],
        "title": "CreateTripRequest",
        "type": "object"
      },
      "PlannerPrincipalResponse": {
        "properties": {
          "planner_id": {
            "format": "uuid",
            "title": "Planner Id",
            "type": "string"
          }
        },
        "required": [
          "planner_id"
        ],
        "title": "PlannerPrincipalResponse",
        "type": "object"
      },
      "ProblemResponse": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          },
          "run_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Id"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "retryable",
          "request_id"
        ],
        "title": "ProblemResponse",
        "type": "object"
      },
      "RunResponse": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "terminal_outcome": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RunTerminalOutcomeResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "trip_id": {
            "format": "uuid",
            "title": "Trip Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "trip_id",
          "status",
          "terminal_outcome"
        ],
        "title": "RunResponse",
        "type": "object"
      },
      "RunStatus": {
        "enum": [
          "Running",
          "Succeeded",
          "Blocked",
          "Failed",
          "Cancelled"
        ],
        "title": "RunStatus",
        "type": "string"
      },
      "RunTerminalOutcomeResponse": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/RunTerminalStatus"
          }
        },
        "required": [
          "status",
          "code",
          "detail"
        ],
        "title": "RunTerminalOutcomeResponse",
        "type": "object"
      },
      "RunTerminalStatus": {
        "enum": [
          "Succeeded",
          "Blocked",
          "Failed",
          "Cancelled"
        ],
        "title": "RunTerminalStatus",
        "type": "string"
      },
      "ServiceStatusResponse": {
        "properties": {
          "api_version": {
            "const": "v1",
            "title": "Api Version",
            "type": "string"
          },
          "service": {
            "const": "flash-trips-api",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "api_version",
          "service",
          "status"
        ],
        "title": "ServiceStatusResponse",
        "type": "object"
      },
      "TripListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/TripResponse"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "TripListResponse",
        "type": "object"
