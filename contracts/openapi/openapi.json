        "properties": {
          "city": {
            "title": "City",
            "type": "string"
          },
          "ends_on": {
            "format": "date",
            "title": "Ends On",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "nights": {
            "title": "Nights",
            "type": "integer"
          },
          "starts_on": {
            "format": "date",
            "title": "Starts On",
            "type": "string"
          }
        },
        "required": [
          "id",
          "city",
          "starts_on",
          "ends_on",
          "nights"
        ],
        "title": "TripStayResponse",
        "type": "object"
      },
