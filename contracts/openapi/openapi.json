        "properties": {
          "stays": {
            "items": {
              "$ref": "#/components/schemas/TripStayInput"
            },
            "minItems": 1,
            "title": "Stays",
            "type": "array"
          }
        },
        "required": [
          "stays"
        ],
        "title": "TripStructureInput",
        "type": "object"
      },
      "TripStructureResponse": {
        "properties": {
          "stays": {
            "items": {
              "$ref": "#/components/schemas/TripStayResponse"
