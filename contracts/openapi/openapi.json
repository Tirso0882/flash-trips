      "TripResponse": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "structure": {
            "$ref": "#/components/schemas/TripStructureResponse"
          }
        },
        "required": [
          "id",
          "structure"
        ],
        "title": "TripResponse",
        "type": "object"
      },
      "TripStayInput": {
        "properties": {
          "city": {
            "maxLength": 200,
            "minLength": 1,
            "title": "City",
            "type": "string"
          },
          "ends_on": {
            "format": "date",
            "title": "Ends On",
            "type": "string"
          },
          "nights": {
            "minimum": 0.0,
            "title": "Nights",
            "type": "integer"
          },
          "starts_on": {
            "format": "date",
            "title": "Starts On",
            "type": "string"
          }
        },
        "required": [
          "city",
          "starts_on",
          "ends_on",
          "nights"
