{
  "name": "flash-trips",
  "private": true,
  "scripts": {
    "contracts": "uv run python scripts/generate_openapi.py && openapi-ts -i contracts/openapi/openapi.json -o contracts/ts/src -c @hey-api/client-fetch",
    "install:journey-browser": "playwright install chromium",
    "prototype:planner": "python3 -m http.server 4173 --directory docs/prototypes",
    "sandcastle": "pnpm exec tsx .sandcastle/main.mts",
    "sandcastle:check": "tsc --project .sandcastle/tsconfig.json",
    "test:acceptance": "node --test tests/acceptance/accept-issue.test.mjs",
    "test:journey": "node --import tsx --test tests/journey/harness.test.mts && playwright test",
    "test:sandcastle": "node --import tsx --test .sandcastle/main.test.mts",
    "traceability": "node scripts/traceability.mjs",
    "test:traceability": "node --test tests/traceability/traceability.test.mjs",
    "test:web-boundaries": "node --conditions=react-server --import ./tests/node/deny-network.mjs --import tsx --test tests/web/boundaries.test.mjs tests/web/oidc.test.mts tests/web/oidc-runtime.test.mts tests/web/session.test.mts",
    "test:web-rendering": "pnpm --dir apps/web exec node --import tsx --test 'app/(planner)/planner/*.test.ts'"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "js-yaml": "4.3.2"
    }
  },
  "dependencies": {
    "@ai-hero/sandcastle": "0.12.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.63.0",
    "@standard-schema/spec": "1.1.0",
    "@types/node": "22.20.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
