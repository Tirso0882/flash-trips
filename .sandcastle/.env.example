# Cursor API key (recommended)
# You can also pass --api-key directly to the agent CLI.
CURSOR_API_KEY=

# Optional AFK limits. Concurrency remains capped at three.
SANDCASTLE_TASK_BUDGET=30
SANDCASTLE_TIME_BUDGET_MINUTES=480

# Comma-separated names only. Put each corresponding secret value in this
# uncommitted file or in the process environment.
SANDCASTLE_TASK_ENV_ALLOWLIST=
